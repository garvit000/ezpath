{
  "name": "ezpath-infrastructure",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "package:lambda": "python ../backend/route_lambda/build_package.py && python ../backend/disruption_lambda/build_package.py && python ../backend/event_publisher_lambda/build_package.py && python ../backend/report_lambda/build_package.py",
    "build": "tsc -p tsconfig.json",
    "test": "npm run package:lambda && npm run build && node --test dist/test/**/*.test.js",
    "synth": "npm run package:lambda && npm run build && cdk synth"
  },
  "dependencies": {
    "aws-cdk-lib": "2.275.0",
    "constructs": "10.8.1",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "aws-cdk": "2.1148.0",
    "typescript": "5.9.3"
  }
}
