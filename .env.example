# EzPath frontend environment variables
# Running in Demo Mode by default (deterministic client-side graph solver & BroadcastChannel sync)
VITE_DEMO_MODE=true

# AWS Integration (Set VITE_DEMO_MODE=false to connect to AWS Backend)
VITE_API_BASE_URL=https://your-http-api-id.execute-api.ap-south-1.amazonaws.com
VITE_AWS_REGION=ap-south-1
VITE_LOCATION_MAP_NAME=EzPathSrmCampusMap
VITE_LOCATION_SATELLITE_MAP_NAME=EzPathSrmSatelliteMap
# Retrieve the browser key after deployment; this value is intentionally not a CDK output.
VITE_LOCATION_API_KEY=replace_with_referer_restricted_browser_key
VITE_COGNITO_USER_POOL_ID=ap-south-1_replace_me
VITE_COGNITO_CLIENT_ID=client_id_placeholder
VITE_COGNITO_DOMAIN=https://your-domain.auth.ap-south-1.amazoncognito.com
VITE_APPSYNC_EVENTS_HTTP_URL=https://your-api-id.appsync-api.ap-south-1.amazonaws.com/event
VITE_APPSYNC_EVENTS_REALTIME_URL=wss://your-api-id.appsync-realtime-api.ap-south-1.amazonaws.com/event/realtime
VITE_APPSYNC_EVENTS_API_KEY=replace_with_deployment_output
VITE_APPSYNC_EVENTS_CHANNEL=/disruptions/network

